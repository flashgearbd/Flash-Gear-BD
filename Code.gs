function nextRecurringDate_(iso,frequency){let p=iso.split("-").map(Number),y=p[0],m=p[1]-1,d=p[2],x;if(frequency==="Daily")x=new Date(Date.UTC(y,m,d+1));else if(frequency==="Weekly")x=new Date(Date.UTC(y,m,d+7));else if(frequency==="Yearly"){let targetY=y+1,day=Math.min(d,new Date(Date.UTC(targetY,m+1,0)).getUTCDate());x=new Date(Date.UTC(targetY,m,day));}else if(frequency==="Monthly"){let target=new Date(Date.UTC(y,m+1,1)),day=Math.min(d,new Date(Date.UTC(target.getUTCFullYear(),target.getUTCMonth()+1,0)).getUTCDate());x=new Date(Date.UTC(target.getUTCFullYear(),target.getUTCMonth(),day));}else throw Error("Invalid recurring frequency.");return Utilities.formatDate(x,"UTC","yyyy-MM-dd");}
function getReport(i){ensureSetup_();i=i||{};let start=normalizeDate_(i.startDate||today_().slice(0,7)+"-01"),end=normalizeDate_(i.endDate||today_()),scope=i.scope||"Combined";if(end<start)throw Error("End date cannot be before start date.");if(!["Combined","Personal","Business"].includes(scope))throw Error("Choose a valid report scope.");let tx=readRows_("Transactions").filter(t=>t.Status==="Posted"&&dateStr_(t.Date)>=start&&dateStr_(t.Date)<=end&&(scope==="Combined"||t.Scope===scope)),cats=readRows_("Categories"),by={};tx.filter(t=>["Income","Expense"].includes(t.Type)).forEach(t=>{let c=cats.find(x=>x.CategoryID===t.CategoryID),k=(c?c.Name:"Uncategorized")+" ("+t.Type+")";by[k]=(by[k]||0)+num_(t.Amount);});let income=sum_(tx.filter(t=>t.Type==="Income"),"Amount"),expense=sum_(tx.filter(t=>t.Type==="Expense"),"Amount");return{startDate:start,endDate:end,scope,income,expense,netCashFlow:income-expense,transactionCount:tx.length,byCategory:Object.keys(by).map(k=>({category:k,amount:round2_(by[k])})).sort((a,b)=>b.amount-a.amount)};}
function exportTransactionsCsv(i){i=i||{};let start=normalizeDate_(i.startDate||"2000-01-01"),end=normalizeDate_(i.endDate||today_()),scope=i.scope||"Combined";if(end<start)throw Error("End date cannot be before start date.");if(!["Combined","Personal","Business"].includes(scope))throw Error("Choose a valid export scope.");let rows=readRows_("Transactions").filter(t=>t.Status==="Posted"&&dateStr_(t.Date)>=start&&dateStr_(t.Date)<=end&&(scope==="Combined"||t.Scope===scope)),h=APP.sheets.Transactions,csv=[h].concat(rows.map(r=>h.map(k=>csvSafe_(r[k])))).map(r=>r.join(",")).join("\r\n");return{content:csv,filename:"money-manager-"+start+"-to-"+end+".csv"};}
function createPdfReport(i){let r=getReport(i||{}),doc=DocumentApp.create("Money Manager Report "+r.startDate+" to "+r.endDate),b=doc.getBody();b.appendParagraph(APP.name).setHeading(DocumentApp.ParagraphHeading.HEADING1);b.appendParagraph("Period: "+r.startDate+" to "+r.endDate+" | Scope: "+r.scope);b.appendParagraph("Income: BDT "+r.income.toFixed(2));b.appendParagraph("Expenses: BDT "+r.expense.toFixed(2));b.appendParagraph("Net cash flow: BDT "+r.netCashFlow.toFixed(2));b.appendParagraph("Transactions: "+r.transactionCount);b.appendParagraph("Category breakdown").setHeading(DocumentApp.ParagraphHeading.HEADING2);r.byCategory.forEach(x=>b.appendParagraph(x.category+": BDT "+x.amount.toFixed(2)));doc.saveAndClose();let f=DriveApp.createFile(DriveApp.getFileById(doc.getId()).getAs(MimeType.PDF).setName("Money-Manager-Report.pdf"));DriveApp.getFileById(doc.getId()).setTrashed(true);return{message:"PDF report created in Google Drive.",url:f.getUrl()};}
function createBackupNow(){ensureSetup_();let ss=getSpreadsheet_(),f=DriveApp.getFileById(ss.getId()).makeCopy("Money Manager Backup "+Utilities.formatDate(new Date(),APP.timezone,"yyyy-MM-dd HHmm"));append_("BackupLog",[id_("BKP"),new Date(),"Success",f.getId(),f.getName(),"Manual backup"]);return{ok:true,message:"Backup created: "+f.getName(),url:f.getUrl()};}
function createDailyBackupTrigger(){ensureSetup_();ScriptApp.getProjectTriggers().filter(t=>t.getHandlerFunction()==="dailyBackup_").forEach(t=>ScriptApp.deleteTrigger(t));ScriptApp.newTrigger("dailyBackup_").timeBased().everyDays(1).atHour(2).inTimezone(APP.timezone).create();return{ok:true,message:"Daily backup trigger enabled (approximately 2 AM Bangladesh time)."};}
function dailyBackup_(){try{createBackupNow();}catch(e){try{append_("BackupLog",[id_("BKP"),new Date(),"Failed","","",String(e)]);}catch(x){}}}
function ensureSetup_(){let id=PropertiesService.getScriptProperties().getProperty("MM_SPREADSHEET_ID");if(!id){let ss=SpreadsheetApp.getActiveSpreadsheet();if(!ss)throw Error("Run setupMoneyManager() from the spreadsheet-bound Apps Script project first.");PropertiesService.getScriptProperties().setProperty("MM_SPREADSHEET_ID",ss.getId());}let ss=getSpreadsheet_();Object.keys(APP.sheets).forEach(n=>{if(!ss.getSheetByName(n))throw Error('Missing sheet "'+n+'". Run setupMoneyManager().');});}
function getSpreadsheet_(){let id=PropertiesService.getScriptProperties().getProperty("MM_SPREADSHEET_ID");if(id)return SpreadsheetApp.openById(id);let ss=SpreadsheetApp.getActiveSpreadsheet();if(!ss)throw Error("Spreadsheet not connected. Run setupMoneyManager().");return ss;}
function readRows_(n){let s=getSpreadsheet_().getSheetByName(n);if(!s||s.getLastRow()<2)return[];let v=s.getRange(1,1,s.getLastRow(),s.getLastColumn()).getValues(),h=v.shift();return v.filter(r=>r.some(x=>x!==""&&x!==null)).map(r=>rowToObj_(h,r));}
function rowToObj_(h,r){let o={};h.forEach((k,i)=>o[k]=r[i]);return o;}
function append_(n,r){let s=getSpreadsheet_().getSheetByName(n);if(!s)throw Error('Missing sheet "'+n+'".');s.appendRow(r);}
function getById_(n,h,id){return id?readRows_(n).find(r=>String(r[h])===String(id))||null:null;}
function setField_(n,idH,id,field,val){let s=getSpreadsheet_().getSheetByName(n),d=s.getDataRange().getValues(),h=d[0],ic=h.indexOf(idH),fc=h.indexOf(field);if(ic<0||fc<0)throw Error("Column not found.");for(let i=1;i<d.length;i++)if(String(d[i][ic])===String(id)){s.getRange(i+1,fc+1).setValue(val);return;}throw Error("Record not found.");}
function id_(p){return p+"-"+Utilities.getUuid().replace(/-/g,"").slice(0,16).toUpperCase();}
function today_(){return Utilities.formatDate(new Date(),APP.timezone,"yyyy-MM-dd");}
function dateStr_(v){if(v===null||v===undefined||v==="")return"";if(v instanceof Date&&!isNaN(v.getTime()))return Utilities.formatDate(v,APP.timezone,"yyyy-MM-dd");let s=String(v);if(/^\d{4}-\d{2}-\d{2}$/.test(s))return validISODate_(s)?s:"";let d=new Date(v);return isNaN(d.getTime())?"":Utilities.formatDate(d,APP.timezone,"yyyy-MM-dd");}
function validISODate_(s){let m=/^(\d{4})-(\d{2})-(\d{2})$/.exec(String(s));if(!m)return false;let d=new Date(Date.UTC(Number(m[1]),Number(m[2])-1,Number(m[3])));return d.getUTCFullYear()===Number(m[1])&&d.getUTCMonth()+1===Number(m[2])&&d.getUTCDate()===Number(m[3]);}
function normalizeDate_(v){if(!v)return today_();let s=String(v).trim();if(/^\d{4}-\d{2}-\d{2}$/.test(s)){if(!validISODate_(s))throw Error("Invalid date: "+s);return s;}let d=new Date(v);if(isNaN(d.getTime()))throw Error("Invalid date: "+s);return Utilities.formatDate(d,APP.timezone,"yyyy-MM-dd");}
function num_(v){let n=Number(v);return isFinite(n)?n:0;}
function round2_(v){let n=Number(v);if(!isFinite(n))throw Error("Enter a valid amount.");return Math.round((n+Number.EPSILON)*100)/100;}
function bool_(v){return v===true||String(v).toLowerCase()==="true"||v===1||String(v)==="1";}
function sum_(r,k){return round2_(r.reduce((s,x)=>s+num_(x[k]),0));}
function withLock_(fn){let l=LockService.getScriptLock();l.waitLock(15000);try{return fn();}finally{l.releaseLock();}}
function audit_(type,id,action,prev,next,reason){append_("AuditLog",[id_("AUD"),new Date(),type,id,action,prev||"",next||"",reason||"",Session.getActiveUser().getEmail()||""]);}
function txPublic_(t){return{id:t.TransactionID,date:dateStr_(t.Date),type:t.Type,scope:t.Scope,categoryId:t.CategoryID||"",amount:num_(t.Amount),accountId:t.AccountID,destinationAccountId:t.DestinationAccountID||"",loanId:t.LoanID||"",counterparty:t.Counterparty||"",paymentMethod:t.PaymentMethod||"",reference:t.Reference||"",notes:t.Notes||"",status:t.Status,submissionKey:t.SubmissionKey||""};}
function accountBalance_(id){let a=getById_("Accounts","AccountID",id);if(!a)return 0;let b=num_(a.OpeningBalance);readRows_("Transactions").filter(t=>t.Status==="Posted").forEach(t=>{let n=num_(t.Amount);if(t.Type==="Transfer"){if(t.AccountID===id)b-=n;if(t.DestinationAccountID===id)b+=n;}else if(t.AccountID===id){if(["Income","Loan Received","Loan Collected"].includes(t.Type))b+=n;else if(["Expense","Loan Given","Loan Repaid"].includes(t.Type))b-=n;}});return round2_(b);}
function validateTransaction_(i){if(!i||typeof i!=="object")throw Error("Transaction details are missing.");if(!["Income","Expense","Transfer","Loan Given","Loan Received","Loan Collected","Loan Repaid"].includes(i.type))throw Error("Choose a valid transaction type.");if(!["Personal","Business"].includes(i.scope))throw Error("Choose Personal or Business.");let n=Number(i.amount);if(!isFinite(n)||n<=0)throw Error("Amount must be greater than zero.");if(n>1e12)throw Error("Amount is too large.");}
function monthSummaries_(count){let tx=readRows_("Transactions").filter(t=>t.Status==="Posted"),out=[],now=new Date();for(let i=count-1;i>=0;i--){let d=new Date(now.getFullYear(),now.getMonth()-i,1),m=Utilities.formatDate(d,APP.timezone,"yyyy-MM"),r=tx.filter(t=>dateStr_(t.Date).slice(0,7)===m);out.push({month:m,income:sum_(r.filter(t=>t.Type==="Income"),"Amount"),expense:sum_(r.filter(t=>t.Type==="Expense"),"Amount")});}return out;}
function csvSafe_(v){let s=v instanceof Date?Utilities.formatDate(v,APP.timezone,"yyyy-MM-dd HH:mm:ss"):String(v===null||v===undefined?"":v);if(/^[=+\-@]/.test(s))s="'"+s;return'"'+s.replace(/"/g,'""')+'"';}
