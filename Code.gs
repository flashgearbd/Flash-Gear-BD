const APP={tz:'Asia/Dhaka',sheets:{Transactions:['TransactionID','Date','CreatedAt','Type','Scope','CategoryID','Amount','AccountID','DestinationAccountID','LoanID','Counterparty','PaymentMethod','Reference','Notes','Status','ReversalOf','SubmissionKey'],Accounts:['AccountID','Name','Scope','Type','OpeningBalance','OpeningDate','Active','Notes'],Categories:['CategoryID','Name','Type','Scope','ParentCategoryID','Active'],Loans:['LoanID','Direction','Scope','PersonName','Phone','Purpose','LoanDate','OriginalAmount','OpeningOutstanding','DueDate','Notes','Active'],Budgets:['BudgetID','Month','Scope','CategoryID','BudgetAmount','Active'],Goals:['GoalID','Name','Scope','TargetAmount','StartDate','TargetDate','LinkedAccountID','Active','Notes'],RecurringRules:['RuleID','Type','Amount','Scope','AccountID','DestinationAccountID','CategoryID','Frequency','StartDate','EndDate','NextDueDate','Active','Notes'],RecurringOccurrences:['OccurrenceID','RuleID','DueDate','Status','TransactionID','ConfirmedAt'],AuditLog:['AuditID','Timestamp','RecordType','RecordID','Action','PreviousData','NewData','Reason','Actor'],Settings:['Key','Value'],BackupLog:['BackupID','Timestamp','Status','FileId','FileName','Details'],ReconciliationHistory:['ReconID','Date','AccountID','CalculatedBalance','ActualBalance','Difference','AdjustmentTransactionID','Reason']}};
function doGet(){return HtmlService.createHtmlOutputFromFile('Index').setTitle('Money Manager').addMetaTag('viewport','width=device-width, initial-scale=1');}
function setupMoneyManager(){const ss=SpreadsheetApp.getActiveSpreadsheet();if(!ss)throw Error('Open Apps Script from the target Google Sheet.');ss.setSpreadsheetTimeZone(APP.tz);Object.keys(APP.sheets).forEach(n=>{let sh=ss.getSheetByName(n)||ss.insertSheet(n);if(!sh.getLastRow()){sh.appendRow(APP.sheets[n]);sh.setFrozenRows(1);sh.getRange(1,1,1,APP.sheets[n].length).setFontWeight('bold').setBackground('#eaf2ff');}});PropertiesService.getScriptProperties().setProperty('MM_ID',ss.getId());seed_();return 'Setup complete';}
function seed_(){if(!rows_('Accounts').length){[['Personal Cash','Personal','Cash'],['Personal Bank','Personal','Bank'],['Personal bKash','Personal','Mobile Wallet'],['Personal Nagad','Personal','Mobile Wallet'],['Business Cash','Business','Cash'],['Business Bank','Business','Bank'],['Business bKash','Business','Mobile Wallet'],['Business Nagad','Business','Mobile Wallet']].forEach(a=>add_('Accounts',[id_('ACC'),a[0],a[1],a[2],0,today_(),true,'']));}if(!rows_('Categories').length){[['Salary','Income','Personal'],['Freelance','Income','Personal'],['Other Income','Income','Personal'],['Food & Dining','Expense','Personal'],['Transport','Expense','Personal'],['Bills','Expense','Personal'],['Family','Expense','Personal'],['Other Personal Expense','Expense','Personal'],['Product Sales','Income','Business'],['Service Income','Income','Business'],['Product Purchases / Inventory','Expense','Business'],['Packaging','Expense','Business'],['Delivery','Expense','Business'],['Marketing','Expense','Business'],['Internet & Phone','Expense','Business'],['Operating Costs','Expense','Business'],['Other Business Expense','Expense','Business']].forEach(c=>add_('Categories',[id_('CAT'),c[0],c[1],c[2],'',true]));}}
function db_(){const id=PropertiesService.getScriptProperties().getProperty('MM_ID');if(id)return SpreadsheetApp.openById(id);const ss=SpreadsheetApp.getActiveSpreadsheet();if(!ss)throw Error('Run setupMoneyManager first.');return ss;}
function rows_(n){const s=db_().getSheetByName(n);if(!s||s.getLastRow()<2)return[];const v=s.getDataRange().getValues(),h=v[0];return v.slice(1).filter(r=>r.some(x=>x!==''&&x!==null)).map(r=>obj_(h,r));}
function obj_(h,r){let o={};h.forEach((k,i)=>o[k]=r[i]);return o;}function add_(n,r){db_().getSheetByName(n).appendRow(r);}function id_(p){return p+'-'+Utilities.getUuid().slice(0,8).toUpperCase();}function today_(){return Utilities.formatDate(new Date(),APP.tz,'yyyy-MM-dd');}function date_(x){if(!x)return today_();return x instanceof Date?Utilities.formatDate(x,APP.tz,'yyyy-MM-dd'):String(x).slice(0,10);}function num_(x){let n=Number(x);return isFinite(n)?n:0;}function round_(x){return Math.round((num_(x)+Number.EPSILON)*100)/100;}function bool_(x){return x===true||String(x).toLowerCase()==='true'||x===1;}function get_(n,k,id){return rows_(n).find(r=>String(r[k])===String(id))||null;}
function audit_(typ,id,act,oldv,newv,reason){add_('AuditLog',[id_('AUD'),new Date(),typ,id,act,oldv||'',newv||'',reason||'',Session.getActiveUser().getEmail()||'']);}
function set_(n,k,id,f,v){const s=db_().getSheetByName(n),a=s.getDataRange().getValues(),h=a[0],ki=h.indexOf(k),fi=h.indexOf(f);for(let i=1;i<a.length;i++)if(String(a[i][ki])===String(id)){s.getRange(i+1,fi+1).setValue(v);return;}throw Error('Record not found');}
function balance_(id){const a=get_('Accounts','AccountID',id);if(!a)return 0;let b=num_(a.OpeningBalance);rows_('Transactions').filter(t=>t.Status==='Posted').forEach(t=>{let n=num_(t.Amount);if(t.AccountID===id){if(['Income','Loan Received','Loan Collected'].includes(t.Type))b+=n;else if(['Expense','Loan Given','Loan Repaid','Transfer'].includes(t.Type))b-=n;}if(t.Type==='Transfer'&&t.DestinationAccountID===id)b+=n;});return round_(b);}
function loanOutstanding_(id){const l=get_('Loans','LoanID',id);if(!l)return 0;let b=num_(l.OpeningOutstanding);rows_('Transactions').filter(t=>t.Status==='Posted'&&t.LoanID===id).forEach(t=>{if(l.Direction==='Given'){if(t.Type==='Loan Given')b+=num_(t.Amount);if(t.Type==='Loan Collected')b-=num_(t.Amount);}else{if(t.Type==='Loan Received')b+=num_(t.Amount);if(t.Type==='Loan Repaid')b-=num_(t.Amount);}});return round_(Math.max(0,b));}
function getAppData(){const tx=rows_('Transactions').filter(t=>t.Status==='Posted'),acc=rows_('Accounts').map(a=>({id:a.AccountID,name:a.Name,scope:a.Scope,type:a.Type,openingBalance:num_(a.OpeningBalance),active:bool_(a.Active),balance:balance_(a.AccountID)})),cats=rows_('Categories').map(c=>({id:c.CategoryID,name:c.Name,type:c.Type,scope:c.Scope,active:bool_(c.Active)})),loans=rows_('Loans').map(l=>({id:l.LoanID,direction:l.Direction,scope:l.Scope,personName:l.PersonName,purpose:l.Purpose||'',originalAmount:num_(l.OriginalAmount),outstanding:loanOutstanding_(l.LoanID),dueDate:date_(l.DueDate),active:bool_(l.Active)}));const m=today_().slice(0,7),mt=tx.filter(t=>date_(t.Date).slice(0,7)===m),income=mt.filter(t=>t.Type==='Income').reduce((s,t)=>s+num_(t.Amount),0),expense=mt.filter(t=>t.Type==='Expense').reduce((s,t)=>s+num_(t.Amount),0);const budgets=rows_('Budgets').map(b=>({id:b.BudgetID,month:b.Month,scope:b.Scope,categoryId:b.CategoryID,amount:num_(b.BudgetAmount),active:bool_(b.Active)}));const goals=rows_('Goals').map(g=>({id:g.GoalID,name:g.Name,scope:g.Scope,targetAmount:num_(g.TargetAmount),startDate:date_(g.StartDate),targetDate:date_(g.TargetDate),linkedAccountId:g.LinkedAccountID||'',active:bool_(g.Active),notes:g.Notes||''}));const recurringRules=rows_('RecurringRules').map(r=>({id:r.RuleID,type:r.Type,amount:num_(r.Amount),scope:r.Scope,accountId:r.AccountID,frequency:r.Frequency,nextDueDate:date_(r.NextDueDate),active:bool_(r.Active),notes:r.Notes||''}));const recurringDue=rows_('RecurringOccurrences').filter(o=>['Due','Overdue'].includes(o.Status)).map(o=>({id:o.OccurrenceID,ruleId:o.RuleID,dueDate:date_(o.DueDate),status:o.Status}));return {today:today_(),month:m,accounts:acc,categories:cats,loans,budgets,goals,recurringRules,recurringDue,transactions:tx.slice(-300).reverse().map(t=>({id:t.TransactionID,date:date_(t.Date),type:t.Type,scope:t.Scope,categoryId:t.CategoryID,amount:num_(t.Amount),accountId:t.AccountID,destinationAccountId:t.DestinationAccountID,loanId:t.LoanID,counterparty:t.Counterparty||'',paymentMethod:t.PaymentMethod||'',reference:t.Reference||'',notes:t.Notes||''})),metrics:{availableMoney:acc.filter(a=>a.active).reduce((s,a)=>s+a.balance,0),income:round_(income),expense:round_(expense),net:round_(income-expense)}};}
function saveTransaction(i){const lock=LockService.getScriptLock();lock.waitLock(20000);try{if(!i||!['Income','Expense','Transfer','Loan Given','Loan Received','Loan Collected','Loan Repaid'].includes(i.type))throw Error('Choose a transaction type.');if(!['Personal','Business'].includes(i.scope))throw Error('Choose a scope.');const amt=round_(i.amount);if(amt<=0)throw Error('Amount must be positive.');if(!i.submissionKey)throw Error('Missing save token; refresh and try again.');const dupe=rows_('Transactions').find(t=>t.SubmissionKey===i.submissionKey);if(dupe)return{ok:true,message:'Already saved; duplicate prevented.'};const a=get_('Accounts','AccountID',i.accountId);if(!a||!bool_(a.Active)||a.Scope!==i.scope)throw Error('Choose an active account in the selected scope.');let dest='';if(i.type==='Transfer'){dest=get_('Accounts','AccountID',i.destinationAccountId);if(!dest||!bool_(dest.Active)||dest.AccountID===a.AccountID)throw Error('Choose a different active destination account.');if(balance_(a.AccountID)<amt)throw Error('Insufficient source balance for this transfer.');}let cat='';if(['Income','Expense'].includes(i.type)){cat=get_('Categories','CategoryID',i.categoryId);if(!cat||!bool_(cat.Active)||cat.Type!==i.type||!(cat.Scope===i.scope||cat.Scope==='Both'))throw Error('Choose a matching category.');}let loan='';if(i.type.startsWith('Loan ')){loan=get_('Loans','LoanID',i.loanId);if(!loan||!bool_(loan.Active))throw Error('Select a loan record.');if(['Loan Given','Loan Collected'].includes(i.type)&&loan.Direction!=='Given')throw Error('This action requires a loan you gave.');if(['Loan Received','Loan Repaid'].includes(i.type)&&loan.Direction!=='Received')throw Error('This action requires a loan you received.');if(['Loan Collected','Loan Repaid'].includes(i.type)&&amt>loanOutstanding_(loan.LoanID)+.005)throw Error('Amount exceeds outstanding principal.');}const id=id_('TX'),row=[id,date_(i.date),new Date(),i.type,i.scope,i.categoryId||'',amt,a.AccountID,dest?dest.AccountID:'',loan?loan.LoanID:'',i.counterparty||'',i.paymentMethod||'Cash',i.reference||'',i.notes||'','Posted','',i.submissionKey];add_('Transactions',row);audit_('Transaction',id,'CREATE','',JSON.stringify(row),'Transaction saved');return{ok:true,message:'Transaction saved.'};}finally{lock.releaseLock();}}
function reverseTransaction(i){const id=i.transactionId,reason=String(i.reason||'').trim();if(!reason)throw Error('A reason is required.');const t=get_('Transactions','TransactionID',id);if(!t||t.Status!=='Posted')throw Error('Posted transaction not found.');if(rows_('Transactions').some(x=>x.ReversalOf===id&&x.Status==='Posted'))throw Error('Already reversed.');const map={Income:'Expense',Expense:'Income','Loan Given':'Loan Collected','Loan Collected':'Loan Given','Loan Received':'Loan Repaid','Loan Repaid':'Loan Received',Transfer:'Transfer'},type=map[t.Type],now=new Date(),rid=id_('TX'),isTr=t.Type==='Transfer';set_('Transactions','TransactionID',id,'Status','Reversed');const row=[rid,today_(),now,type,t.Scope,t.CategoryID,t.Amount,isTr?t.DestinationAccountID:t.AccountID,isTr?t.AccountID:'',t.LoanID,t.Counterparty,t.PaymentMethod,t.Reference,'Reversal of '+id+': '+reason,'Posted',id,'REV-'+Utilities.getUuid()];add_('Transactions',row);audit_('Transaction',id,'REVERSE',JSON.stringify(t),JSON.stringify(row),reason);return{ok:true,message:'Reversed with an audit record.'};}
function addAccount(i){const name=String(i.name||'').trim();if(!name)throw Error('Account name required.');if(!['Personal','Business'].includes(i.scope))throw Error('Choose Personal or Business.');const id=id_('ACC'),r=[id,name,i.scope,i.type||'Cash',round_(i.openingBalance),date_(i.openingDate),true,i.notes||''];add_('Accounts',r);audit_('Account',id,'CREATE','',JSON.stringify(r),'Added account');return{ok:true,message:'Account added.'};}
function updateAccountActive(i){const a=get_('Accounts','AccountID',i.id);if(!a)throw Error('Account not found.');set_('Accounts','AccountID',i.id,'Active',!!i.active);audit_('Account',i.id,i.active?'ACTIVATE':'ARCHIVE',JSON.stringify(a),JSON.stringify({...a,Active:!!i.active}),'Account status changed');return{ok:true};}
function addCategory(i){if(!String(i.name||'').trim())throw Error('Category name required.');if(!['Income','Expense'].includes(i.type)||!['Personal','Business','Both'].includes(i.scope))throw Error('Invalid category type or scope.');const id=id_('CAT'),r=[id,String(i.name).trim(),i.type,i.scope,'',true];add_('Categories',r);audit_('Category',id,'CREATE','',JSON.stringify(r),'Added category');return{ok:true,message:'Category added.'};}
function deleteLoan(i){const loanId=typeof i==='string'?i:String((i&&i.loanId)||'');if(!loanId)throw Error('Loan ID is missing.');const lock=LockService.getScriptLock();lock.waitLock(15000);try{const loan=get_('Loans','LoanID',loanId);if(!loan)throw Error('Loan record not found.');if(rows_('Transactions').some(t=>String(t.LoanID||'')===loanId))throw Error('This loan has transaction history and cannot be deleted safely. Keep it to preserve your financial records.');const sh=db_().getSheetByName('Loans'),data=sh.getDataRange().getValues(),h=data[0],col=h.indexOf('LoanID');for(let r=data.length-1;r>=1;r--){if(String(data[r][col])===loanId){audit_('Loan',loanId,'DELETE',JSON.stringify(loan),'','Loan record deleted');sh.deleteRow(r+1);return{ok:true,message:'Loan deleted.'};}}throw Error('Loan record not found.');}finally{lock.releaseLock();}}
function addLoan(i){const lock=LockService.getScriptLock();lock.waitLock(20000);try{const name=String(i.personName||'').trim(),orig=round_(i.originalAmount),isExisting=i.isExisting===true,out=round_(isExisting?i.openingOutstanding:0);if(!name||orig<=0||out<0||out>orig)throw Error('Check person and loan amounts.');if(!['Given','Received'].includes(i.direction)||!['Personal','Business'].includes(i.scope))throw Error('Invalid loan details.');let account=null;if(!isExisting){account=get_('Accounts','AccountID',i.accountId);if(!account||!bool_(account.Active)||account.Scope!==i.scope)throw Error('Choose an active account matching the loan scope.');}const id=id_('LOAN'),r=[id,i.direction,i.scope,name,i.phone||'',i.purpose||'',date_(i.loanDate),orig,out,i.dueDate?date_(i.dueDate):'',i.notes||'',true];add_('Loans',r);audit_('Loan',id,'CREATE','',JSON.stringify(r),isExisting?'Existing loan opening balance':'New loan with linked cash transaction');if(!isExisting){const type=i.direction==='Received'?'Loan Received':'Loan Given',txid=id_('TX'),key='LOAN-'+id;const tx=[txid,date_(i.loanDate),new Date(),type,i.scope,'',orig,account.AccountID,'',id,name,i.paymentMethod||'bKash',i.reference||'',i.notes||'Automatically created with loan record','Posted','',key];add_('Transactions',tx);audit_('Transaction',txid,'CREATE','',JSON.stringify(tx),'Automatically linked to new loan');}return{ok:true,message:isExisting?'Existing loan saved without changing account balance.':'Loan saved and matching account transaction created automatically.'};}finally{lock.releaseLock();}}
function addBudget(i){const a=round_(i.amount),c=get_('Categories','CategoryID',i.categoryId);if(!/^\d{4}-\d{2}$/.test(i.month)||a<=0||!c||c.Type!=='Expense')throw Error('Check month, amount and expense category.');const id=id_('BUD'),r=[id,i.month,i.scope,c.CategoryID,a,true];add_('Budgets',r);audit_('Budget',id,'CREATE','',JSON.stringify(r),'Added budget');return{ok:true,message:'Budget saved.'};}
function addGoal(i){const a=round_(i.targetAmount);if(!String(i.name||'').trim()||a<=0)throw Error('Enter a goal name and target.');const id=id_('GOAL'),r=[id,i.name,i.scope,a,date_(i.startDate),i.targetDate?date_(i.targetDate):'',i.linkedAccountId||'',true,i.notes||''];add_('Goals',r);audit_('Goal',id,'CREATE','',JSON.stringify(r),'Added savings goal');return{ok:true,message:'Goal saved.'};}
function addRecurringRule(i){const a=round_(i.amount);if(a<=0||!['Daily','Weekly','Monthly','Yearly'].includes(i.frequency))throw Error('Check amount and frequency.');const id=id_('REC'),start=date_(i.startDate),r=[id,i.type,a,i.scope,i.accountId,i.destinationAccountId||'',i.categoryId||'',i.frequency,start,i.endDate?date_(i.endDate):'',start,true,i.notes||''];add_('RecurringRules',r);audit_('RecurringRule',id,'CREATE','',JSON.stringify(r),'Added recurring rule');return{ok:true,message:'Recurring rule saved; it will not auto-post.'};}
function prepareRecurringDueItems(){const today=today_();rows_('RecurringRules').filter(r=>bool_(r.Active)).forEach(r=>{const d=date_(r.NextDueDate||r.StartDate);if(d<=today&&(!r.EndDate||d<=date_(r.EndDate))&&!rows_('RecurringOccurrences').some(o=>o.RuleID===r.RuleID&&date_(o.DueDate)===d&&!['Skipped','Cancelled'].includes(o.Status)))add_('RecurringOccurrences',[id_('OCC'),r.RuleID,d,d<today?'Overdue':'Due','','']);});return{ok:true,message:'Due items checked. Review them in the sheet before posting.'};}
function reconcileAccount(i){const a=get_('Accounts','AccountID',i.accountId);if(!a)throw Error('Account not found.');const calc=balance_(a.AccountID),actual=round_(i.actualBalance),diff=round_(actual-calc),reason=String(i.reason||'').trim();if(Math.abs(diff)>.005&&!reason)throw Error('Reason required for a difference.');const id=id_('RECX');add_('ReconciliationHistory',[id,date_(i.date),a.AccountID,calc,actual,diff,'',reason]);audit_('Reconciliation',id,'CREATE','',JSON.stringify({calc,actual,diff}),reason||'Recorded');return{ok:true,message:'Reconciliation recorded; no automatic adjustment made.',calculated:calc,difference:diff};}
function getReport(i){const start=date_(i.startDate),end=date_(i.endDate),scope=i.scope||'Combined',tx=rows_('Transactions').filter(t=>t.Status==='Posted'&&date_(t.Date)>=start&&date_(t.Date)<=end&&(scope==='Combined'||t.Scope===scope));const cats={};rows_('Categories').forEach(c=>cats[c.CategoryID]=c.Name);let by={};tx.filter(t=>['Income','Expense'].includes(t.Type)).forEach(t=>{let k=t.Type+' · '+(cats[t.CategoryID]||'Uncategorized');by[k]=(by[k]||0)+num_(t.Amount)});const inc=tx.filter(t=>t.Type==='Income').reduce((s,t)=>s+num_(t.Amount),0),exp=tx.filter(t=>t.Type==='Expense').reduce((s,t)=>s+num_(t.Amount),0);return{startDate:start,endDate:end,scope,transactionCount:tx.length,income:round_(inc),expense:round_(exp),netCashFlow:round_(inc-exp),byCategory:Object.keys(by).sort().map(k=>({category:k,amount:round_(by[k])})),transactions:tx};}
function exportTransactionsCsv(i){const r=getReport(i),rows=[['Date','Type','Scope','Category ID','Amount BDT','Account ID','Counterparty','Payment Method','Reference','Notes']];r.transactions.forEach(t=>rows.push([date_(t.Date),t.Type,t.Scope,t.CategoryID,t.Amount,t.AccountID,t.Counterparty,t.PaymentMethod,t.Reference,t.Notes]));return{filename:'money-manager-'+r.startDate+'-'+r.endDate+'.csv',content:rows.map(r=>r.map(v=>'"'+String(v==null?'':v).replace(/"/g,'""')+'"').join(',')).join('\r\n')};}
function createBackupNow(){const ss=db_(),copy=DriveApp.getFileById(ss.getId()).makeCopy('Money Manager Backup '+Utilities.formatDate(new Date(),APP.tz,'yyyy-MM-dd HH-mm'));add_('BackupLog',[id_('BKP'),new Date(),'Success',copy.getId(),copy.getName(),'Spreadsheet copy created']);return{ok:true,message:'Backup created in your Google Drive: '+copy.getName()};}
function createDailyBackupTrigger(){ScriptApp.getProjectTriggers().filter(t=>t.getHandlerFunction()==='scheduledBackup_').forEach(t=>ScriptApp.deleteTrigger(t));ScriptApp.newTrigger('scheduledBackup_').timeBased().everyDays(1).atHour(2).inTimezone(APP.tz).create();return{ok:true,message:'Daily backup trigger enabled.'};}function scheduledBackup_(){try{createBackupNow();}catch(e){add_('BackupLog',[id_('BKP'),new Date(),'Failed','','',String(e)]);}}
function createPdfReport(i){const r=getReport(i),html='<h1>Money Manager Report</h1><p>Period: '+r.startDate+' to '+r.endDate+' · '+r.scope+' · BDT</p><p>Income: ৳'+r.income+' | Expenses: ৳'+r.expense+' | Net cash flow: ৳'+r.netCashFlow+'</p><table border="1" cellpadding="6" cellspacing="0"><tr><th>Category</th><th>Amount (BDT)</th></tr>'+r.byCategory.map(x=>'<tr><td>'+x.category+'</td><td>'+x.amount+'</td></tr>').join('')+'</table><p>Generated in Asia/Dhaka time.</p>';const f=DriveApp.createFile(Utilities.newBlob(html,'text/html','report.html').getAs('application/pdf').setName('Money-Manager-Report.pdf'));return{ok:true,url:f.getUrl(),message:'PDF report created in Drive.'};}
