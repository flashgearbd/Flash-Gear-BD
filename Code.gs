/**
 * Personal Financial Management System — Google Sheets + Apps Script
 * Version 2.0 starter implementation. Currency: BDT; timezone: Asia/Dhaka.
 * Start with a NEW Google Sheet. Run setupSystem() from its bound Apps Script project.
 * Protect the spreadsheet and deploy the web app to your own account only.
 */
const PFM = {
  VERSION: '2.0.0', TZ: 'Asia/Dhaka', CURRENCY: '৳',
  HEADERS: {
    Transactions: ['ID','Date','Type','Category','Amount','FromAccountID','ToAccountID','Description','Reference','PaymentMethod','Status','ReversalOf','SubmissionKey','CreatedAt','UpdatedAt'],
    Accounts: ['ID','Name','Type','OpeningBalance','OpeningDate','Active','Notes','CreatedAt','UpdatedAt'],
    Categories: ['ID','Name','Type','Active','ParentID','Notes','CreatedAt','UpdatedAt'],
    Loans: ['ID','Date','Type','Person','Amount','DueDate','AccountID','Status','Notes','CreatedAt','UpdatedAt'],
    LoanPayments: ['ID','LoanID','Date','Amount','AccountID','Direction','Notes','TransactionID','CreatedAt'],
    Budgets: ['ID','Name','CategoryID','Period','LimitAmount','StartDate','Active','CreatedAt','UpdatedAt'],
    Goals: ['ID','Name','TargetAmount','CurrentAmount','TargetDate','AccountID','Status','Notes','CreatedAt','UpdatedAt'],
    RecurringRules: ['ID','Name','Type','CategoryID','Amount','FromAccountID','ToAccountID','Frequency','NextDate','EndDate','Notes','Active','LastPostedDate','CreatedAt','UpdatedAt'],
    AuditLog: ['ID','Timestamp','Action','Entity','EntityID','BeforeJSON','AfterJSON','Note','Actor'],
    Settings: ['Key','Value','UpdatedAt'],
    ReconciliationHistory: ['ID','Date','AccountID','ExpectedBalance','ActualBalance','Difference','Notes','CreatedAt'],
    BackupLog: ['ID','Timestamp','FileID','FileName','Status','Notes']
  },
  DEFAULT_ACCOUNTS: ['Cash','bKash','Nagad','Rocket','Bank Account'],
  DEFAULT_CATEGORIES: {
    Income: ['Salary','Business Income','Freelance','Investment Return','Gift','Refund','Other Income'],
    Expense: ['Food','Transport','House Rent','Utilities','Mobile & Internet','Medical','Shopping','Education','Family','Entertainment','Travel','Other Expense']
  }
};

function doGet() {
  return HtmlService.createHtmlOutputFromFile('Index').setTitle('Personal Finance Manager')
    .addMetaTag('viewport','width=device-width, initial-scale=1, viewport-fit=cover');
}
function setupSystem() {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  if (!ss) throw new Error('Create/open a Google Sheet, then use Extensions → Apps Script and run setupSystem().');
  const props = PropertiesService.getScriptProperties();
  props.setProperty('PFM_SPREADSHEET_ID', ss.getId());
  Object.keys(PFM.HEADERS).forEach(name => {
    let sh = ss.getSheetByName(name); if (!sh) sh = ss.insertSheet(name);
    const headers = PFM.HEADERS[name];
    if (sh.getLastRow() === 0) sh.getRange(1,1,1,headers.length).setValues([headers]);
    else {
      const actual = sh.getRange(1,1,1,Math.max(1,sh.getLastColumn())).getDisplayValues()[0];
      if (headers.some((h,i)=>actual[i] !== h)) throw new Error('Header mismatch in '+name+'. Setup stopped without changing existing data. Use a NEW blank spreadsheet.');
    }
    sh.setFrozenRows(1); sh.getRange(1,1,1,headers.length).setFontWeight('bold').setBackground('#dff3f3');
    sh.autoResizeColumns(1,Math.min(headers.length,8));
  });
  if (sheet_('Accounts').getLastRow() === 1) {
    const now = new Date();
    PFM.DEFAULT_ACCOUNTS.forEach((name,i)=>sheet_('Accounts').appendRow([uid_(),name,i===0?'Cash':'Digital/Bank',0,now,true,'',now,now]));
  }
  if (sheet_('Categories').getLastRow() === 1) {
    const now = new Date();
    Object.keys(PFM.DEFAULT_CATEGORIES).forEach(type=>PFM.DEFAULT_CATEGORIES[type].forEach(name=>sheet_('Categories').appendRow([uid_(),name,type,true,'','',now,now])));
  }
  const set = sheet_('Settings');
  if (set.getLastRow() === 1) [['Currency','BDT (৳)'],['Timezone',PFM.TZ],['SetupComplete','true'],['BudgetAlert80','true'],['BudgetAlert100','true'],['BudgetAlertOver','true']].forEach(r=>set.appendRow([r[0],r[1],new Date()]));
  return {ok:true,message:'Setup complete. No existing rows were overwritten.',spreadsheetUrl:ss.getUrl()};
}
function getSS_(){const id=PropertiesService.getScriptProperties().getProperty('PFM_SPREADSHEET_ID');if(id)return SpreadsheetApp.openById(id);const ss=SpreadsheetApp.getActiveSpreadsheet();if(!ss)throw new Error('Run setupSystem() first.');return ss;}
function sheet_(n){const s=getSS_().getSheetByName(n);if(!s)throw new Error('Missing sheet '+n+'. Run setupSystem() first.');return s;}
function rows_(n){const s=sheet_(n),lr=s.getLastRow();return lr<2?[]:s.getRange(2,1,lr,PFM.HEADERS[n].length).getValues();}
function uid_(){return Utilities.getUuid();}
function str_(v){return String(v==null?'':v).trim();}
function money_(v){const n=Number(v);if(!Number.isFinite(n)||n<=0)throw new Error('Amount must be greater than zero.');return Math.round((n+Number.EPSILON)*100)/100;}
function round_(n){return Math.round((Number(n||0)+Number.EPSILON)*100)/100;}
function date_(v,optional){if(!v&&optional)return '';if(!v)throw new Error('Date is required.');const d=v instanceof Date?v:new Date(v);if(isNaN(d.getTime()))throw new Error('Invalid date.');return d;}
function fmt_(v){return v instanceof Date?Utilities.formatDate(v,PFM.TZ,"yyyy-MM-dd'T'HH:mm"):str_(v);}
function safe_(fn){try{return {ok:true,data:fn()};}catch(e){console.error(e&&e.stack||e);return {ok:false,message:e.message||String(e)};}}
function locked_(fn){const l=LockService.getScriptLock();l.waitLock(20000);try{return fn();}finally{l.releaseLock();}}
function actor_(){try{return Session.getActiveUser().getEmail()||'authorized user';}catch(e){return 'authorized user';}}
function audit_(action,entity,id,before,after,note){sheet_('AuditLog').appendRow([uid_(),new Date(),action,entity,id,before?JSON.stringify(before):'',after?JSON.stringify(after):'',str_(note),actor_()]);}
function find_(name,id){const s=sheet_(name),lr=s.getLastRow();if(lr<2)return -1;const ids=s.getRange(2,1,lr-1,1).getDisplayValues().flat();const i=ids.indexOf(String(id));return i<0?-1:i+2;}
function objRows_(name){return rows_(name).map(r=>{const o={};PFM.HEADERS[name].forEach((h,i)=>o[h]=r[i] instanceof Date?fmt_(r[i]):r[i]);return o;});}
function activeAccounts_(){return rows_('Accounts').filter(r=>r[5]===true||String(r[5]).toLowerCase()==='true').map(r=>({id:String(r[0]),name:String(r[1]),type:String(r[2]),openingBalance:Number(r[3])||0,openingDate:fmt_(r[4]),notes:String(r[6]||'')}));}
function activeCategories_(type){return rows_('Categories').filter(r=>(r[3]===true||String(r[3]).toLowerCase()==='true')&&(!type||r[2]===type)).map(r=>({id:String(r[0]),name:String(r[1]),type:String(r[2]),parentId:String(r[4]||''),notes:String(r[5]||'')}));}
function transactionObjects_(){return rows_('Transactions').filter(r=>r[10]==='POSTED').map(r=>({id:String(r[0]),date:fmt_(r[1]),type:String(r[2]),categoryId:String(r[3]||''),amount:Number(r[4])||0,fromAccountId:String(r[5]||''),toAccountId:String(r[6]||''),description:String(r[7]||''),reference:String(r[8]||''),paymentMethod:String(r[9]||''),status:String(r[10]),reversalOf:String(r[11]||''),createdAt:fmt_(r[13])}));}
function allTxRaw_(){return rows_('Transactions');}
function recalcBalances_(){
  const accounts=activeAccounts_(), tx=transactionObjects_();
  return accounts.map(a=>{let balance=Number(a.openingBalance)||0,inflow=0,outflow=0;tx.forEach(t=>{if(t.toAccountId===a.id){balance+=t.amount;inflow+=t.amount;}if(t.fromAccountId===a.id){balance-=t.amount;outflow+=t.amount;}});return {...a,balance:round_(balance),inflow:round_(inflow),outflow:round_(outflow)};});
}
function accountName_(id){const a=rows_('Accounts').find(r=>String(r[0])===String(id));return a?String(a[1]):'';}
function categoryName_(id){const c=rows_('Categories').find(r=>String(r[0])===String(id));return c?String(c[1]):'';}
function txValidation_(p){const type=str_(p.type),amount=money_(p.amount),date=date_(p.date),accounts=activeAccounts_(),cats=activeCategories_();if(!['Income','Expense','Transfer','Adjustment'].includes(type))throw new Error('Choose a valid transaction type.');const from=str_(p.fromAccountId),to=str_(p.toAccountId),categoryId=str_(p.categoryId);if(type==='Transfer'){if(!from||!to||from===to)throw new Error('Choose two different accounts for a transfer.');if(!accounts.some(a=>a.id===from)||!accounts.some(a=>a.id===to))throw new Error('Choose active accounts.');}else if(type==='Income'){if(!to||!accounts.some(a=>a.id===to))throw new Error('Choose the account receiving money.');if(!cats.some(c=>c.id===categoryId&&c.type==='Income'))throw new Error('Choose an income category.');}else if(type==='Expense'){if(!from||!accounts.some(a=>a.id===from))throw new Error('Choose the account paying money.');if(!cats.some(c=>c.id===categoryId&&c.type==='Expense'))throw new Error('Choose an expense category.');}else{if(!from&&!to)throw new Error('Choose an account for the adjustment.');if(from&&to)throw new Error('Adjustment must affect only one account.');}
  return {type,amount,date,categoryId,fromAccountId:from,toAccountId:to,description:str_(p.description).slice(0,2000),reference:str_(p.reference).slice(0,150),paymentMethod:str_(p.paymentMethod).slice(0,80)};}
function addTransaction(p){return safe_(()=>locked_(()=>{p=p||{};const key=str_(p.submissionKey);if(key&&rows_('Transactions').some(r=>String(r[12])===key))return {duplicate:true,message:'This submission was already saved.'};const v=txValidation_(p),id=uid_(),now=new Date();sheet_('Transactions').appendRow([id,v.date,v.type,v.categoryId,v.amount,v.fromAccountId,v.toAccountId,v.description,v.reference,v.paymentMethod,'POSTED','',key,now,now]);audit_('CREATE','Transaction',id,null,v,'');return {id,message:'Transaction saved.'};}));}
function correctTransaction(p){return safe_(()=>locked_(()=>{const id=str_(p.id),row=find_('Transactions',id);if(row<0)throw new Error('Transaction not found.');const sh=sheet_('Transactions'),old=sh.getRange(row,1,1,15).getValues()[0];if(old[10]!=='POSTED')throw new Error('Only posted transactions can be corrected.');const v=txValidation_(p),now=new Date();sh.getRange(row,11).setValue('REVERSED');sh.getRange(row,15).setValue(now);const reversalId=uid_();sh.appendRow([reversalId,now,'Adjustment','',Number(old[4]),old[6],old[5],'Reversal of '+id+' · '+str_(p.correctionNote),String(old[8]||''),'System','POSTED',id,'',now,now]);const newId=uid_();sheet_('Transactions').appendRow([newId,v.date,v.type,v.categoryId,v.amount,v.fromAccountId,v.toAccountId,v.description,v.reference,v.paymentMethod,'POSTED','',str_(p.submissionKey),now,now]);audit_('CORRECT','Transaction',id,old,v,str_(p.correctionNote));return {id:newId,message:'Correction saved with an audit trail and reversal.'};}));}
function reverseTransaction(p){return safe_(()=>locked_(()=>{const id=str_(p.id),row=find_('Transactions',id);if(row<0)throw new Error('Transaction not found.');const sh=sheet_('Transactions'),r=sh.getRange(row,1,1,15).getValues()[0];if(r[10]!=='POSTED')throw new Error('This transaction is not posted.');const now=new Date(),rid=uid_();sh.getRange(row,11).setValue('REVERSED');sh.getRange(row,15).setValue(now);sh.appendRow([rid,now,'Adjustment','',Number(r[4]),r[6],r[5],'Reversal of '+id+' · '+str_(p.reason),'','System','POSTED',id,'',now,now]);audit_('REVERSE','Transaction',id,r,{reversalId:rid},str_(p.reason));return {message:'Transaction reversed. Original history was preserved.'};}));}
function addAccount(p){return safe_(()=>locked_(()=>{const name=str_(p.name);if(!name||name.length>80)throw new Error('Enter an account name up to 80 characters.');if(rows_('Accounts').some(r=>String(r[1]).toLowerCase()===name.toLowerCase()&&(r[5]===true||String(r[5]).toLowerCase()==='true')))throw new Error('An active account with that name already exists.');const now=new Date(),id=uid_(),opening=Number(p.openingBalance||0);if(!Number.isFinite(opening))throw new Error('Invalid opening balance.');sheet_('Accounts').appendRow([id,name,str_(p.type)||'Cash/Bank',round_(opening),date_(p.openingDate||now),true,str_(p.notes).slice(0,1000),now,now]);audit_('CREATE','Account',id,null,p,'');return {id};}));}
function updateAccount(p){return safe_(()=>locked_(()=>{const id=str_(p.id),row=find_('Accounts',id);if(row<0)throw new Error('Account not found.');const sh=sheet_('Accounts'),old=sh.getRange(row,1,1,9).getValues()[0],name=str_(p.name),opening=Number(p.openingBalance);if(!name||!Number.isFinite(opening))throw new Error('Valid name and opening balance are required.');const now=new Date();sh.getRange(row,1,1,9).setValues([[id,name,str_(p.type)||old[2],round_(opening),date_(p.openingDate||old[4]),old[5],str_(p.notes),old[7],now]]);audit_('UPDATE','Account',id,old,p,'');return {message:'Account updated.'};}));}
function deactivateAccount(p){return safe_(()=>locked_(()=>{const id=str_(p.id),row=find_('Accounts',id);if(row<0)throw new Error('Account not found.');const sh=sheet_('Accounts'),old=sh.getRange(row,1,1,9).getValues()[0];sh.getRange(row,6).setValue(false);sh.getRange(row,9).setValue(new Date());audit_('DEACTIVATE','Account',id,old,null,'Historical transactions retained');return {message:'Account deactivated. History remains intact.'};}));}
function addCategory(p){return safe_(()=>locked_(()=>{const name=str_(p.name),type=str_(p.type);if(!name||!['Income','Expense'].includes(type))throw new Error('Enter a name and choose Income or Expense.');if(rows_('Categories').some(r=>r[2]===type&&String(r[1]).toLowerCase()===name.toLowerCase()&&(r[3]===true||String(r[3]).toLowerCase()==='true')))throw new Error('Category already exists.');const now=new Date(),id=uid_();sheet_('Categories').appendRow([id,name,type,true,str_(p.parentId),str_(p.notes),now,now]);audit_('CREATE','Category',id,null,p,'');return {id};}));}
function deactivateCategory(p){return safe_(()=>locked_(()=>{const id=str_(p.id),row=find_('Categories',id);if(row<0)throw new Error('Category not found.');const sh=sheet_('Categories'),old=sh.getRange(row,1,1,8).getValues()[0];sh.getRange(row,4).setValue(false);sh.getRange(row,8).setValue(new Date());audit_('DEACTIVATE','Category',id,old,null,'Existing transactions retained');return {message:'Category deactivated.'};}));}
function addLoan(p){return safe_(()=>locked_(()=>{const type=str_(p.type);if(!['Loan Taken','Loan Given'].includes(type))throw new Error('Choose Loan Taken or Loan Given.');const person=str_(p.person),amount=money_(p.amount),accountId=str_(p.accountId),date=date_(p.date);if(!person)throw new Error('Person is required.');if(!activeAccounts_().some(a=>a.id===accountId))throw new Error('Choose an active account.');const id=uid_(),now=new Date();sheet_('Loans').appendRow([id,date,type,person,amount,date_(p.dueDate,true),accountId,'Active',str_(p.notes),now,now]);const txid=uid_();sheet_('Transactions').appendRow([txid,date,type,'',amount,type==='Loan Taken'?'':accountId,type==='Loan Taken'?accountId:'',type+' · Loan '+id,'','Loan','POSTED','',uid_(),now,now]);audit_('CREATE','Loan',id,null,p,'');return {id,transactionId:txid};}));}
function addLoanPayment(p){return safe_(()=>locked_(()=>{const id=str_(p.loanId),row=find_('Loans',id);if(row<0)throw new Error('Loan not found.');const loan=sheet_('Loans').getRange(row,1,1,11).getValues()[0],amount=money_(p.amount),date=date_(p.date),accountId=str_(p.accountId);const payments=rows_('LoanPayments').filter(r=>String(r[1])===id).reduce((s,r)=>s+(Number(r[3])||0),0),remaining=round_(Number(loan[4])-payments);if(amount>remaining+0.001)throw new Error('Payment exceeds remaining balance ('+remaining+').');if(!activeAccounts_().some(a=>a.id===accountId))throw new Error('Choose an active account.');const direction=loan[2]==='Loan Taken'?'Repayment':'Return',pid=uid_(),txid=uid_(),now=new Date();sheet_('LoanPayments').appendRow([pid,id,date,amount,accountId,direction,str_(p.notes),txid,now]);sheet_('Transactions').appendRow([txid,date,direction==='Repayment'?'Loan Repayment':'Loan Return','',amount,direction==='Repayment'?accountId:'',direction==='Return'?accountId:'',direction+' · Loan '+id,'',str_(p.paymentMethod),'POSTED','',uid_(),now,now]);if(round_(payments+amount)>=Number(loan[4]))sheet_('Loans').getRange(row,8).setValue('Settled');audit_('CREATE','LoanPayment',pid,null,p,'');return {id:pid,remaining:round_(remaining-amount)};}));}
function addBudget(p){return safe_(()=>locked_(()=>{const name=str_(p.name),categoryId=str_(p.categoryId),period=str_(p.period)||'Monthly',limit=money_(p.limitAmount),start=date_(p.startDate||new Date());if(!name)throw new Error('Budget name required.');if(!['Monthly','Weekly','Yearly'].includes(period))throw new Error('Invalid budget period.');const id=uid_(),now=new Date();sheet_('Budgets').appendRow([id,name,categoryId,period,limit,start,true,now,now]);audit_('CREATE','Budget',id,null,p,'');return {id};}));}
function addGoal(p){return safe_(()=>locked_(()=>{const name=str_(p.name),target=money_(p.targetAmount),current=Math.max(0,Number(p.currentAmount)||0),now=new Date();if(!name)throw new Error('Goal name required.');const id=uid_();sheet_('Goals').appendRow([id,name,target,current,date_(p.targetDate,true),str_(p.accountId),'Active',str_(p.notes),now,now]);audit_('CREATE','Goal',id,null,p,'');return {id};}));}
function updateGoalProgress(p){return safe_(()=>locked_(()=>{const id=str_(p.id),row=find_('Goals',id);if(row<0)throw new Error('Goal not found.');const sh=sheet_('Goals'),old=sh.getRange(row,1,1,10).getValues()[0],current=Number(p.currentAmount);if(!Number.isFinite(current)||current<0)throw new Error('Enter a valid saved amount.');sh.getRange(row,5).setValue(date_(p.targetDate||old[4],true));sh.getRange(row,4).setValue(round_(current));sh.getRange(row,7).setValue(current>=Number(old[2])?'Completed':'Active');sh.getRange(row,10).setValue(new Date());audit_('UPDATE','Goal',id,old,{currentAmount:current},'');return {message:'Goal updated.'};}));}
function addRecurringRule(p){return safe_(()=>locked_(()=>{const type=str_(p.type),frequency=str_(p.frequency),amount=money_(p.amount);if(!['Income','Expense','Transfer'].includes(type))throw new Error('Invalid recurring transaction type.');if(!['Daily','Weekly','Monthly','Yearly'].includes(frequency))throw new Error('Invalid frequency.');const v=txValidation_({...p,date:p.nextDate});const id=uid_(),now=new Date();sheet_('RecurringRules').appendRow([id,str_(p.name)||type,type,v.categoryId,amount,v.fromAccountId,v.toAccountId,frequency,date_(p.nextDate),date_(p.endDate,true),v.description,true,'',now,now]);audit_('CREATE','RecurringRule',id,null,p,'');return {id};}));}
function runDueRecurring(){return safe_(()=>locked_(()=>{const sh=sheet_('RecurringRules'),data=rows_('RecurringRules'),today=new Date();today.setHours(23,59,59,999);let count=0;data.forEach((r,i)=>{if(!(r[11]===true||String(r[11]).toLowerCase()==='true'))return;const next=date_(r[8]),end=r[9]?date_(r[9],true):'';if(next>today||(end&&next>end))return;const id=uid_(),now=new Date();sh.appendRow;sheet_('Transactions').appendRow([id,next,r[2],r[3],Number(r[4]),r[5],r[6],r[10]||('Recurring: '+r[1]),'','Recurring','POSTED','',uid_(),now,now]);let newDate=new Date(next);if(r[7]==='Daily')newDate.setDate(newDate.getDate()+1);else if(r[7]==='Weekly')newDate.setDate(newDate.getDate()+7);else if(r[7]==='Monthly')newDate.setMonth(newDate.getMonth()+1);else newDate.setFullYear(newDate.getFullYear()+1);sh.getRange(i+2,9).setValue(newDate);sh.getRange(i+2,13).setValue(next);sh.getRange(i+2,15).setValue(now);audit_('POST_RECURRING','Transaction',id,null,{ruleId:r[0],date:fmt_(next)},'Manual confirmation was triggered by user');count++;});return {posted:count,message:count+' due recurring transaction(s) posted.'};}));}
function reconcileAccount(p){return safe_(()=>locked_(()=>{const accountId=str_(p.accountId),actual=Number(p.actualBalance);if(!activeAccounts_().some(a=>a.id===accountId)||!Number.isFinite(actual))throw new Error('Choose an account and enter its actual balance.');const expected=recalcBalances_().find(a=>a.id===accountId).balance,diff=round_(actual-expected),id=uid_(),now=new Date();sheet_('ReconciliationHistory').appendRow([id,now,accountId,expected,actual,diff,str_(p.notes),now]);audit_('RECONCILE','Account',accountId,{expected},{actual,difference:diff},str_(p.notes));return {expected,actual,difference:diff,message:diff===0?'Account reconciled.':'Difference recorded. Review before making any adjustment.'};}));}
function getDashboard(p){return safe_(()=>{p=p||{};const tx=transactionObjects_(),accounts=recalcBalances_(),loans=rows_('Loans'),payments=rows_('LoanPayments'),now=new Date(),start=p.from?date_(p.from):new Date(now.getFullYear(),now.getMonth(),1),end=p.to?date_(p.to):now;end.setHours(23,59,59,999);const period=tx.filter(t=>{const d=new Date(t.date);return d>=start&&d<=end;});const income=round_(period.filter(t=>t.type==='Income').reduce((s,t)=>s+t.amount,0)),expense=round_(period.filter(t=>t.type==='Expense').reduce((s,t)=>s+t.amount,0));const byCategory={};period.filter(t=>t.type==='Expense').forEach(t=>{const n=categoryName_(t.categoryId)||'Uncategorised';byCategory[n]=(byCategory[n]||0)+t.amount;});const budgetRows=rows_('Budgets').filter(r=>r[6]===true||String(r[6]).toLowerCase()==='true').map(r=>{const cat=String(r[2]),limit=Number(r[4])||0;const spent=round_(period.filter(t=>t.type==='Expense'&&(!cat||t.categoryId===cat)).reduce((s,t)=>s+t.amount,0));return {id:String(r[0]),name:String(r[1]),category:categoryName_(cat)||'All expenses',period:String(r[3]),limit,spent,percent:limit?Math.round(spent/limit*100):0};});const loanSummary=loans.reduce((s,r)=>{const paid=payments.filter(p=>String(p[1])===String(r[0])).reduce((a,p)=>a+Number(p[3]||0),0);s.outstanding+=Math.max(0,Number(r[4])-paid)*(r[2]==='Loan Taken'?1:-1);return s;},{outstanding:0});const goals=rows_('Goals').map(r=>({id:String(r[0]),name:String(r[1]),target:Number(r[2]),current:Number(r[3]),percent:Number(r[2])?Math.min(100,Math.round(Number(r[3])/Number(r[2])*100)):0,targetDate:fmt_(r[4]),status:String(r[6])}));return {currency:PFM.CURRENCY,period:{from:fmt_(start),to:fmt_(end)},income,expense,net:round_(income-expense),totalBalance:round_(accounts.reduce((s,a)=>s+a.balance,0)),accounts,categoryBreakdown:Object.keys(byCategory).map(k=>({name:k,amount:round_(byCategory[k])})).sort((a,b)=>b.amount-a.amount),budgets:budgetRows,goals,loanNetOutstanding:round_(loanSummary.outstanding),recent:tx.slice(-20).reverse().map(t=>({...t,category:categoryName_(t.categoryId),fromAccount:accountName_(t.fromAccountId),toAccount:accountName_(t.toAccountId)})),transactionsCount:tx.length};});}
function getInitialData(){return safe_(()=>({dashboard:getDashboard({}).data,accounts:activeAccounts_(),allAccounts:objRows_('Accounts'),categories:activeCategories_(),allCategories:objRows_('Categories'),transactions:transactionObjects_().slice(-500).reverse().map(t=>({...t,category:categoryName_(t.categoryId),fromAccount:accountName_(t.fromAccountId),toAccount:accountName_(t.toAccountId)})),loans:rows_('Loans').map(r=>({id:String(r[0]),date:fmt_(r[1]),type:String(r[2]),person:String(r[3]),amount:Number(r[4]),dueDate:fmt_(r[5]),accountId:String(r[6]),account:accountName_(r[6]),status:String(r[7]),paid:round_(rows_('LoanPayments').filter(p=>String(p[1])===String(r[0])).reduce((s,p)=>s+Number(p[3]||0),0)),remaining:round_(Number(r[4])-rows_('LoanPayments').filter(p=>String(p[1])===String(r[0])).reduce((s,p)=>s+Number(p[3]||0),0)),notes:String(r[8]||'')})),budgets:objRows_('Budgets'),goals:objRows_('Goals'),recurring:objRows_('RecurringRules'),settings:objRows_('Settings'),audit:objRows_('AuditLog').slice(-100).reverse(),reconciliations:objRows_('ReconciliationHistory').slice(-100).reverse()}));}
function searchTransactions(p){return safe_(()=>{p=p||{};const q=str_(p.query).toLowerCase(),type=str_(p.type),from=p.from?new Date(p.from):null,to=p.to?new Date(p.to+'T23:59:59'):null;return transactionObjects_().filter(t=>{const d=new Date(t.date);if(type&&type!=='All'&&t.type!==type)return false;if(from&&d<from)return false;if(to&&d>to)return false;const hay=[t.date,t.type,categoryName_(t.categoryId),accountName_(t.fromAccountId),accountName_(t.toAccountId),t.description,t.reference,t.paymentMethod,t.amount].join(' ').toLowerCase();return !q||hay.includes(q);}).slice(-1000).reverse().map(t=>({...t,category:categoryName_(t.categoryId),fromAccount:accountName_(t.fromAccountId),toAccount:accountName_(t.toAccountId)}));});}
function exportCsv(){return safe_(()=>{const tx=transactionObjects_().map(t=>[t.id,t.date,t.type,categoryName_(t.categoryId),t.amount,accountName_(t.fromAccountId),accountName_(t.toAccountId),t.description,t.reference,t.paymentMethod,t.status]);const head=['ID','Date','Type','Category','Amount BDT','From Account','To Account','Description','Reference','Payment Method','Status'];const csv=[head,...tx].map(r=>r.map(v=>'"'+String(v==null?'':v).replace(/"/g,'""')+'"').join(',')).join('\r\n');return {filename:'personal-finance-transactions.csv',csv};});}
function backupNow(){return safe_(()=>locked_(()=>{const ss=getSS_(),file=DriveApp.getFileById(ss.getId()),copy=file.makeCopy('PFM Backup '+Utilities.formatDate(new Date(),PFM.TZ,'yyyy-MM-dd HHmmss'));sheet_('BackupLog').appendRow([uid_(),new Date(),copy.getId(),copy.getName(),'SUCCESS','Spreadsheet copy created; verify Drive access.']);audit_('BACKUP','Spreadsheet',ss.getId(),null,{fileId:copy.getId(),name:copy.getName()},'');return {fileId:copy.getId(),fileName:copy.getName(),url:copy.getUrl(),message:'Backup copy created in Google Drive.'};}));}
function getPdfReport(){return safe_(()=>{const d=getDashboard({}).data;const html='<html><head><meta charset="utf-8"><style>body{font-family:Arial;padding:28px;color:#172a35}h1{color:#0f766e}table{border-collapse:collapse;width:100%}td,th{padding:8px;border-bottom:1px solid #ddd;text-align:left}.metric{font-size:20px;font-weight:bold}</style></head><body><h1>Personal Finance Report</h1><p>Generated '+Utilities.formatDate(new Date(),PFM.TZ,'dd MMM yyyy HH:mm')+'</p><table><tr><th>Metric</th><th>Amount</th></tr><tr><td>Total account balance</td><td>৳ '+d.totalBalance+'</td></tr><tr><td>Period income</td><td>৳ '+d.income+'</td></tr><tr><td>Period expenses</td><td>৳ '+d.expense+'</td></tr><tr><td>Net cash flow</td><td>৳ '+d.net+'</td></tr></table><h2>Account balances</h2><table><tr><th>Account</th><th>Balance</th></tr>'+d.accounts.map(a=>'<tr><td>'+escHtml_(a.name)+'</td><td>৳ '+a.balance+'</td></tr>').join('')+'</table><h2>Expense categories</h2><table><tr><th>Category</th><th>Amount</th></tr>'+d.categoryBreakdown.map(c=>'<tr><td>'+escHtml_(c.name)+'</td><td>৳ '+c.amount+'</td></tr>').join('')+'</table></body></html>';const blob=Utilities.newBlob(html,'text/html','report.html').getAs(MimeType.PDF).setName('Personal-Finance-Report.pdf');const f=DriveApp.createFile(blob);return {url:f.getUrl(),fileName:f.getName(),message:'PDF report created in Google Drive.'};});}
function escHtml_(s){return String(s==null?'':s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));}
