{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "flash-gear-bd",
  "main": "flash-gear-bd-worker.js",
  "compatibility_date": "2026-10-04",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": ["/api", "/api/*", "/admin", "/admin/*", "/admin.html"],
    "not_found_handling": "single-page-application"
  }
}
